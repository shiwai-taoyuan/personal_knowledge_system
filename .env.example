OPENAI_API_KEY=your_api_key_here
# 可改为兼容 OpenAI 的代理/本地模型网关地址，例如 http://localhost:11434/v1
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
CHECKPOINTS_DIR=/path/to/checkpoints
BGE_MODEL_PATH=/path/to/checkpoints/bge-small-zh-v1d5
QWEN_MODEL_PATH=/path/to/checkpoints/Qwen3-0d6B
EMBEDDING_PROVIDER=local_bge
CHAT_PROVIDER=local_qwen
VECTOR_INDEX_DIR=data/index
DOCS_DIR=data/docs
CHUNK_SIZE=260
CHUNK_OVERLAP=36
MIN_CHUNK_CHARS=70
INGEST_REBUILD_DEFAULT=true
DEFAULT_TOP_K=4
RETRIEVAL_CANDIDATE_K=12
RETRIEVAL_SCORE_THRESHOLD=0.35
RERANKER_TYPE=similarity
RERANKER_MODEL=BAAI/bge-reranker-base
MAX_PER_SOURCE=2
MAX_CONTEXT_CHARS=4000
TEMPERATURE=0.2
QWEN_DISABLE_THINKING=true
